# Standard-compatible custom Responses endpoint. All three values are required
# when provider_profile=custom-responses is selected.
CUSTOM_RESPONSES_BASE_URL=
CUSTOM_RESPONSES_API_KEY=
CUSTOM_RESPONSES_MODEL=

# Kimi coding routes.
# OpenAI Chat benchmark model: kimi-k2.7-code. K2.7 Code uses provider-side
# Thinking On; do not add a thinking=disabled override.
KIMI_OPENAI_BASE_URL=
KIMI_API_KEY=

# MiniMax Responses route.
# Benchmark model: MiniMax-M3
MM_BASE_URL=
MM_API_KEY=

# Optional validation worlds. These routes remain hidden from default
# discovery and require explicit selection plus injected dependencies.
ROBOCLAWS_AGIBOT_RUNNER_SCRIPT=
ROBOCLAWS_AGIBOT_RUNNER_PYTHON=
ROBOCLAWS_AGIBOT_MAP_ARTIFACT_DIR=
ROBOCLAWS_B1_MAP_BUNDLE=
ROBOCLAWS_B1_SCENE_USD_PATH=

# Provider/model defaults, key names, wire APIs, and route health live in
# roboclaws/agents/provider_registry.py. camera-raw-fpv runs require a route
# with verified runtime image transport, not only an image-capable model id.
