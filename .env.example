# Office-network detection. Keep the internal probe URL machine-local.
ROBOCLAWS_WORK_NETWORK_PROBE_URL=

# Local Isaac/NVIDIA runtime contract (required for Isaac runs).
OMNI_KIT_ACCEPT_EULA=YES

# Codex Responses route. All three values are required when selected.
CODEX_RESPONSES_BASE_URL=
CODEX_RESPONSES_API_KEY=
CODEX_RESPONSES_MODEL=

# MiMo Responses route. All three values are required when selected.
MIMO_RESPONSES_BASE_URL=
MIMO_RESPONSES_API_KEY=
MIMO_RESPONSES_MODEL=

# MiMo token-plan OpenAI Chat route.
MIMO_OPENAI_BASE_URL=
MIMO_TP_KEY=

# Kimi token-plan OpenAI Chat route.
KIMI_OPENAI_BASE_URL=
KIMI_API_KEY=

# MiniMax token-plan Responses route.
MM_BASE_URL=
MM_API_KEY=

# Optional validation worlds. These routes remain hidden from default
# discovery and require explicit selection plus injected dependencies.
ROBOCLAWS_AGIBOT_RUNNER_SCRIPT=
ROBOCLAWS_AGIBOT_RUNNER_PYTHON=
ROBOCLAWS_AGIBOT_MAP_ARTIFACT_DIR=
ROBOCLAWS_B1_MAP_BUNDLE=
ROBOCLAWS_B1_SCENE_USD_PATH=

# Provider/model defaults, key names, wire APIs, and route health live in
# roboclaws/core/provider_catalog.py. camera-raw-fpv runs require a route
# with verified runtime image transport, not only an image-capable model id.
